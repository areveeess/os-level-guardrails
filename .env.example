# ============================================================
#  .env.example — SAFE TO COMMIT (no real key here!)
#  
#  HOW TO USE:
#    1. Copy this file: cp .env.example .env
#    2. Open .env and paste your real API keys
#    3. Never commit .env (it's in .gitignore)
#
#  Only the keys for models you use are needed (see config/models.yaml).
#  Ollama and the from-scratch model run locally and need no key.
# ============================================================

# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional — https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
